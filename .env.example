# Copia este archivo a .env y completa los valores locales. No subas .env al repositorio.

# Puerto del microservicio
SERVER_PORT=8089

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Credenciales SMTP (Zoho Mail). Obligatorias para enviar correos.
MAIL_USERNAME=cuidadoseguro@zohomail.com
MAIL_PASSWORD=
